// ============================================
// SETUPLETTERASSETS.GS - อัปโหลดโลโก้/ลายเซ็นเข้า Drive (รันครั้งเดียว)
// ============================================

// รูปครุฑ (PNG) แปลงเป็น Base64
const LOGO_BASE64 = '';
// รูปลายเซ็นสแกน (JPEG) แปลงเป็น Base64
const SIGNATURE_BASE64 = '';

function setupLetterAssets() {
  const root = DriveApp.getFolderById(DRIVE_ROOT_FOLDER_ID);
  const assetsFolder = getOrCreateSubfolder_(root, 'Assets_เอกสาร');

  // อัปโหลดโลโก้ครุฑ
  const logoBlob = Utilities.newBlob(Utilities.base64Decode(LOGO_BASE64), 'image/png', 'logo_ครุฑ.png');
  const logoFile = assetsFolder.createFile(logoBlob);
  setConfigValue_('LETTER_LOGO_FILE_ID', logoFile.getId(), 'File ID ของโลโก้ครุฑสำหรับหนังสือราชการ');

  // อัปโหลดลายเซ็นสแกน
  const sigBlob = Utilities.newBlob(Utilities.base64Decode(SIGNATURE_BASE64), 'image/jpeg', 'ลายเซ็นสแกน.jpeg');
  const sigFile = assetsFolder.createFile(sigBlob);
  setConfigValue_('LETTER_SIGNATURE_FILE_ID', sigFile.getId(), 'File ID ของลายเซ็นสแกนสำหรับหนังสือราชการ');

  SpreadsheetApp.getUi().alert(
    'อัปโหลดไฟล์สำเร็จ!\n\n' +
    'โลโก้: ' + logoFile.getUrl() + '\n' +
    'ลายเซ็น: ' + sigFile.getUrl()
  );
}
